# Classic FizzBuzz.
# Run with:  python3 -m vyrel examples/fizzbuzz.vyr

fn fizzbuzz(n)
  if n % 15 == 0 then
    return "FizzBuzz"
  elif n % 3 == 0 then
    return "Fizz"
  elif n % 5 == 0 then
    return "Buzz"
  end
  return str(n)
end

let i = 1
while i <= 20 do
  print(fizzbuzz(i))
  i = i + 1
end
